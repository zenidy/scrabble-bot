# Copy to .env (gitignored) and fill in. Never commit tokens.
# Token from the website's Team page ("Generate token"), first run only;
# it is then kept in TOKEN_FILE.
BOT_TOKEN=
# ...or a credential nonce instead of a token:
# BOT_NONCE=
STDB_HOST=https://maincloud.spacetimedb.com
STDB_DB=scrabblebot
BOT_NAME=The Scrabbler
RUST_LOG=info
